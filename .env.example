# Copy to .env.local — never commit real values.
# Supabase key names follow the current Supabase SSR guide (publishable / secret keys).
# VERIFIED 2026-11-17: https://supabase.com/docs/guides/auth/server-side/creating-a-client?framework=nextjs

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=              # server only (sb_secret_… or legacy service_role key)

# Gemini (free tier) — pick model after checking AI Studio (DECISIONS O-003)
GEMINI_API_KEY=                   # server only
GEMINI_MODEL=
AI_DAILY_CALLS_PER_USER=15
AI_GLOBAL_DAILY_CAP=200           # ASSUMPTION placeholder — set below your project's RPD shown in AI Studio

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                # server only
VAPID_SUBJECT=mailto:

# Scheduler — shared secret sent by Supabase Cron to /api/cron/dispatch (D-021)
CRON_SECRET=                      # server only, long random string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE_DEFAULT=Asia/Kolkata
INVITE_ONLY=true
PHOTO_RETENTION_DAYS=90
PLATE_REMINDER_OFFSET_MIN=30
PUSH_DAILY_CAP=4

# USDA FoodData Central import (scripts/import-fdc.ts) — free key from https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=

# Phase 2 — Oura OAuth
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=               # server only
OURA_REDIRECT_URI=
