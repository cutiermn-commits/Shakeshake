/**
 * Builds supabase/migrations/0005_seed_recipe_library.sql from src/lib/data/recipe-library.ts (D-031).
 * Nutrition is computed by the app's own engine from the USDA FDC foods seed (0004) — never typed by hand.
 * Fails if any recipe is invalid, contradicts its diet label, or is < 70 % matched (would be "AI estimate").
 *   node scripts/build-recipe-library.mts
 */
import { readFileSync, writeFileSync } from "node:fs";
import { createHash } from "node:crypto";
import { PGlite } from "@electric-sql/pglite";
import { RECIPE_LIBRARY } from "../src/lib/data/recipe-library.ts";
import { FoodMatcher, type FoodRecord } from "../src/lib/nutrition/match.ts";
import { computeRecipeNutrition } from "../src/lib/nutrition/compute.ts";
import { findConflicts } from "../src/lib/nutrition/allergy.ts";

const root = new URL("../", import.meta.url);
const db = new PGlite();
await db.exec(`create table public.foods (id uuid primary key default gen_random_uuid(), key text unique, fdc_id int, name text, fdc_description text, aliases text[], aisle text, is_staple boolean,
  kcal_per_100g numeric, protein_g numeric, fat_g numeric, carb_g numeric, fibre_g numeric, source text, source_release text, reviewed boolean);`);
await db.exec(readFileSync(new URL("supabase/migrations/0004_seed_foods.sql", root), "utf8"));
const { rows } = await db.query<{ key: string; name: string; aliases: string[]; kcal_per_100g: string; protein_g: string; fat_g: string; carb_g: string }>("select * from public.foods");
const foods: FoodRecord[] = rows.map((f) => ({ id: f.key, key: f.key, name: f.name, aliases: f.aliases, kcalPer100g: Number(f.kcal_per_100g), proteinG: Number(f.protein_g), fatG: Number(f.fat_g), carbG: Number(f.carb_g) }));
const matcher = new FoodMatcher(foods);

const MEAT = ["chicken", "mutton", "fish", "prawn", "crab", "meat", "keema", "squid", "anchovy", "mackerel", "tuna", "seer"];
const q = (s: string) => `'${s.replace(/'/g, "''")}'`;
const uuidFrom = (s: string) => {
  const h = createHash("sha1").update(`shake-shake-library:${s}`).digest("hex");
  return `${h.slice(0, 8)}-${h.slice(8, 12)}-5${h.slice(13, 16)}-a${h.slice(17, 20)}-${h.slice(20, 32)}`;
};

const recipeRows: string[] = [];
const ingRows: string[] = [];
const report: string[] = [];
let failed = 0;
const titles = new Set<string>();
for (const r of RECIPE_LIBRARY) {
  if (titles.has(r.title)) { console.error(`DUPLICATE: ${r.title}`); failed++; continue; }
  titles.add(r.title);
  const meatHits = r.diet_type === "nonveg" ? [] : findConflicts(r, [], r.diet_type === "veg" ? [...MEAT, "egg"] : MEAT);
  if (meatHits.length) { console.error(`DIET MISMATCH ${r.title}: ${meatHits.map((h) => h.declared).join(",")}`); failed++; continue; }
  const n = computeRecipeNutrition(r.ingredients, matcher, { title: r.title, steps: r.steps, servings: r.servings });
  report.push(`${n.status.padEnd(9)} ${String(Math.round(n.matchedMassPct * 100)).padStart(3)}%  ${String(n.perServing.kcal).padStart(4)} kcal  ${String(n.perServing.proteinG).padStart(5)} g P  ${r.meal_type.padEnd(6)} ${r.title}${n.unmatched.length ? `   (unmatched: ${n.unmatched.join(", ")})` : ""}`);
  if (n.status === "ai_estimate") { failed++; continue; }
  const id = uuidFrom(r.title);
  recipeRows.push(`  (${q(id)}, ${q(r.title)}, ${q(r.region)}, ${q(r.meal_type)}, ${q(r.diet_type)}, ${r.servings}, ${r.cook_minutes}, ${q(JSON.stringify(r.steps))}::jsonb, ${q(r.protein_tip)}, ${q(r.why)}, 'built-in library (written by Claude)', 'library-2026-11-18', null, ${q(n.status)}, ${n.perServing.kcal}, ${n.perServing.proteinG}, ${n.perServing.fatG}, ${n.perServing.carbG}, ${n.matchedMassPct}, ${n.oilAdded}, ${q(`{${n.unmatched.map((u) => `"${u.replace(/"/g, "")}"`).join(",")}}`)}, '2026-01-01T00:00:00Z')`);
  n.ingredients.forEach((ing, i) => {
    ingRows.push(`  (${q(id)}, ${i}, ${ing.foodId ? `(select id from public.foods where key = ${q(ing.foodId)})` : "null"}, ${q(ing.rawName)}, ${ing.grams}, ${ing.matched}, ${!!ing.added})`);
  });
}
console.log(report.join("\n"));
if (failed) { console.error(`\n${failed} recipe(s) failed — fix them before generating.`); process.exit(1); }

writeFileSync(
  new URL("supabase/migrations/0005_seed_recipe_library.sql", root),
  `-- GENERATED by scripts/build-recipe-library.mts from src/lib/data/recipe-library.ts (D-031). Do not edit by hand.
-- Built-in recipes so suggestions work when the AI is busy. Nutrition computed from the USDA FDC foods seed (0004).
-- created_at is fixed in the past so freshly AI-generated recipes always sort first.
insert into public.recipes (id, title, cuisine_region, meal_type, diet_type, servings, cook_minutes, steps, protein_tip, why, ai_model, prompt_version, created_by,
  nutrition_status, per_serving_kcal, per_serving_protein_g, per_serving_fat_g, per_serving_carb_g, matched_mass_pct, oil_added, unmatched, created_at) values
${recipeRows.join(",\n")}
on conflict (id) do update set title = excluded.title, steps = excluded.steps, protein_tip = excluded.protein_tip, why = excluded.why, nutrition_status = excluded.nutrition_status,
  per_serving_kcal = excluded.per_serving_kcal, per_serving_protein_g = excluded.per_serving_protein_g, per_serving_fat_g = excluded.per_serving_fat_g,
  per_serving_carb_g = excluded.per_serving_carb_g, matched_mass_pct = excluded.matched_mass_pct, oil_added = excluded.oil_added, unmatched = excluded.unmatched;

delete from public.recipe_ingredients where recipe_id in (${recipeRows.length ? RECIPE_LIBRARY.map((r) => q(uuidFrom(r.title))).join(", ") : "null"});
insert into public.recipe_ingredients (recipe_id, position, food_id, raw_name, grams, matched, added) values
${ingRows.join(",\n")};
`,
);
console.log(`\nwrote ${recipeRows.length} recipes, ${ingRows.length} ingredient rows`);
