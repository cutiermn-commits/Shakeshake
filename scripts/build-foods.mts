/**
 * Builds supabase/migrations/0004_seed_foods.sql from USDA FoodData Central downloads (CC0 1.0).
 * BACKLOG M2-01 · CLAUDE.md C6 · NUTRITION_RULES §3.
 *
 * Usage (Node ≥ 22.18 runs .ts directly):
 *   node scripts/build-foods.mts <sr_legacy_food_json> <foundation_food_json>
 * Data: https://fdc.nal.usda.gov/download-datasets  (SR Legacy 2018-04 JSON, Foundation 2026-10-29 JSON)
 *
 * Each catalogue item's `fdcQuery` is matched to the best raw/unprepared FDC record. Every match is
 * written to docs/FOODS_IMPORT_REPORT.md for HUMAN REVIEW; rows are inserted with reviewed=false.
 * Items with no acceptable match are left out (the app then marks recipes using them as partial /
 * AI estimate rather than inventing a number).
 */
import { readFileSync, writeFileSync } from "node:fs";
import { INGREDIENT_CATALOG } from "../src/lib/data/ingredients.ts";

type Nutrient = { nutrient: { number?: string; unitName?: string }; amount?: number };
type Food = { fdcId: number; description: string; dataType: string; foodNutrients: Nutrient[] };

const [srPath, fndPath] = process.argv.slice(2);
if (!srPath || !fndPath) {
  console.error("usage: node scripts/build-foods.mts <sr_legacy.json> <foundation.json>");
  process.exit(1);
}
const sr: Food[] = JSON.parse(readFileSync(srPath, "utf8")).SRLegacyFoods;
const fnd: Food[] = JSON.parse(readFileSync(fndPath, "utf8")).FoundationFoods;
const RELEASES: Record<string, string> = { "SR Legacy": "SR Legacy 2018-04", Foundation: "Foundation 2026-10-29" };

const PREPARED = /\b(cooked|boiled|fried|roasted|baked|grilled|braised|stewed|broiled|canned|frozen|microwaved|steamed|sauteed|dehydrated|breaded|with salt|salted|sweetened|prepared|drained|heated)\b/i;
const words = (s: string) => s.toLowerCase().replace(/[^a-z0-9%.\s]/g, " ").split(/\s+/).filter(Boolean);

function nutrients(f: Food) {
  const get = (num: string) => f.foodNutrients.find((n) => n.nutrient?.number === num)?.amount;
  let kcal = get("208");
  if (kcal == null) {
    const kj = get("268");
    if (kj != null) kcal = kj / 4.184;
  }
  return { kcal, protein: get("203"), fat: get("204"), carb: get("205"), fibre: get("291") };
}

function score(query: string, f: Food): number {
  const q = words(query);
  const d = words(f.description);
  const dset = new Set(d);
  const hit = q.filter((t) => dset.has(t) || d.some((w) => w.startsWith(t) && t.length >= 4)).length;
  let s = hit / q.length;
  if (PREPARED.test(f.description) && !PREPARED.test(query)) s -= 0.3;
  s -= Math.max(0, d.length - q.length) * 0.01; // prefer the most specific/shortest description
  return s;
}

const MIN_SCORE = 0.75;
const rows: string[] = [];
const report: string[] = [
  "# USDA FDC import report",
  "",
  `Generated by scripts/build-foods.ts on ${new Date().toISOString().slice(0, 10)} from SR Legacy (2018-04) and Foundation (2026-10-29) JSON downloads.`,
  "Source: USDA FoodData Central — public domain (CC0 1.0), https://fdc.nal.usda.gov/.",
  "",
  "**Every row needs human review** (ASSUMPTION: the closest FDC description is a fair proxy for the Indian ingredient). Rows are imported with `reviewed = false`.",
  "",
  "| Key | Ingredient | FDC id | FDC description | Dataset | kcal | P | F | C | Score |",
  "|---|---|---|---|---|---|---|---|---|---|",
];
const missing: string[] = [];
const q = (s: string) => `'${s.replace(/'/g, "''")}'`;
const n2 = (x: number | undefined) => (x == null ? "null" : (Math.round(x * 100) / 100).toString());

for (const item of INGREDIENT_CATALOG) {
  let best: { f: Food; s: number } | null = null;
  for (const f of [...sr, ...fnd]) {
    const s = score(item.fdcQuery, f);
    const n = nutrients(f);
    if (n.kcal == null || n.protein == null || n.fat == null || n.carb == null) continue;
    if (!best || s > best.s + 1e-9 || (Math.abs(s - best.s) < 1e-9 && f.dataType === "Foundation")) best = { f, s };
  }
  if (!best || best.s < MIN_SCORE) {
    missing.push(`${item.key} (“${item.fdcQuery}”${best ? `, best: ${best.f.description} @ ${best.s.toFixed(2)}` : ""})`);
    continue;
  }
  const n = nutrients(best.f);
  rows.push(
    `  (${q(item.key)}, ${best.f.fdcId}, ${q(item.name)}, ${q(best.f.description)}, ${q(`{${item.aliases.map((a) => `"${a.replace(/"/g, "")}"`).join(",")}}`)}, ${q(item.aisle)}, ${item.staple ? "true" : "false"}, ${n2(n.kcal)}, ${n2(n.protein)}, ${n2(n.fat)}, ${n2(n.carb)}, ${n2(n.fibre)}, 'USDA FDC', ${q(RELEASES[best.f.dataType] ?? best.f.dataType)}, false)`,
  );
  report.push(`| ${item.key} | ${item.name} | ${best.f.fdcId} | ${best.f.description} | ${best.f.dataType} | ${n2(n.kcal)} | ${n2(n.protein)} | ${n2(n.fat)} | ${n2(n.carb)} | ${best.s.toFixed(2)} |`);
}

report.push("", `## Not matched (${missing.length}) — recipes using these show “≈ partly calculated” / “AI estimate”`, "", ...missing.map((m) => `- ${m}`), "");
writeFileSync(
  new URL("../supabase/migrations/0004_seed_foods.sql", import.meta.url),
  `-- GENERATED by scripts/build-foods.ts from USDA FoodData Central (CC0 1.0). Do not edit by hand.\n-- Review docs/FOODS_IMPORT_REPORT.md, then set reviewed = true for checked rows.\ninsert into public.foods (key, fdc_id, name, fdc_description, aliases, aisle, is_staple, kcal_per_100g, protein_g, fat_g, carb_g, fibre_g, source, source_release, reviewed) values\n${rows.join(",\n")}\non conflict (key) do update set fdc_id = excluded.fdc_id, fdc_description = excluded.fdc_description, aliases = excluded.aliases, aisle = excluded.aisle,\n  is_staple = excluded.is_staple, kcal_per_100g = excluded.kcal_per_100g, protein_g = excluded.protein_g, fat_g = excluded.fat_g, carb_g = excluded.carb_g,\n  fibre_g = excluded.fibre_g, source_release = excluded.source_release, reviewed = false;\n`,
);
writeFileSync(new URL("../docs/FOODS_IMPORT_REPORT.md", import.meta.url), report.join("\n"));
console.log(`matched ${rows.length}/${INGREDIENT_CATALOG.length}; unmatched ${missing.length}`);
